# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=          # openssl rand -hex 32

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://...

# Storage
BLOB_READ_WRITE_TOKEN=

# Email (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=TnB

# Cron
CRON_SECRET=

# Mercado Pago — credenciales de sandbox (test)
MP_PUBLIC_KEY_TEST=APP_USR-...
MP_ACCESS_TOKEN_TEST=APP_USR-...
MP_TEST_MODE=true          # false en producción

# Encriptación de credenciales MP en DB
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
